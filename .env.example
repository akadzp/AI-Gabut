PORT=3000
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Default "." = folder tempat npm run dev dijalankan.
# Bisa diarahkan ke folder project lain.
AI_WORKSPACE_ROOT=.

TERMINAL_TIMEOUT_MS=10000
TERMINAL_MAX_OUTPUT=20000
WORKSPACE_MAX_FILE_SIZE=1000000

# Optional automatic model routing.
# JSON array of provider/model profiles. If omitted, OPENAI_MODEL and GEMINI_MODEL are used as candidates.
# AI_ROUTER_MODELS=[{"provider":"openai","model":"...","capabilities":["coding","analysis"],"maxContextTokens":128000,"latencyMs":1800,"inputCost":2,"outputCost":6,"tags":["balanced"]}]

# Security & governance
AI_GOVERNANCE_MODE=strict
AI_ALLOW_NETWORK_TOOLS=false
GOVERNANCE_AUDIT_MAX=500
